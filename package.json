{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "bun test tests",
    "registry:build": "shadcn build",
    "smoke": "bun scripts/smoke-registry.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "depcruise": "depcruise app components hooks lib tests scripts --config",
    "test:e2e": "playwright test",
    "check": "bun run lint && bun run typecheck && bun run depcruise && bun run test && bun run registry:build && git diff --exit-code public/r && bun run build",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.30.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/typography": "^0.5.9",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.2.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "lint-staged": "^17.6.2",
    "shadcn": "^3.0.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged && bun run typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": "eslint --max-warnings=0"
  }
}
